{
  "manifest_version": 3,
  "name": "Bj Beyond Scanner",
  "version": "1.0.0",
  "description": "Analyze any website for opportunities",
  "permissions": ["storage", "scripting", "activeTab", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
