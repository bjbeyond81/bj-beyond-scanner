{
  "manifest_version": 3,
  "name": "Bj Beyond Scanner",
  "version": "1.0.1",
  "description": "Analyze any website for SEO, conversion, trust and technical opportunities.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["https://bj-beyond-scanner-production.up.railway.app/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bj Beyond Scanner"
  }
}
